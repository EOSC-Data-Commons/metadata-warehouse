services:
    flower:
        ports:
            - "127.0.0.1:5555:5555"
        environment:
            FLOWER_UNAUTHENTICATED_API: true

    transform:
        ports:
            - "127.0.0.1:8080:80"
        # Uncomment for dev (hot reload):
        # command: [ "fastapi", "dev", "--host", "0.0.0.0", "transform.py", "--port", "80" ]

    celery:
        # Uncomment for dev (auto-restart on file changes):
        # command:
        #   [ "watchmedo", "auto-restart",
        #     "--debug-force-polling",
        #     "--directory=/code/src",
        #     "--directory=/code/config",
        #     "--pattern=*.py", "--recursive", "--",
        #     "celery", "-A", "tasks", "worker",
        #     "-E", "--concurrency=1", "--pool=prefork", "--loglevel=DEBUG"
        #   ]

    postgres:
        ports:
            - "127.0.0.1:5432:5432"

    pgadmin:
        ports:
            - "127.0.0.1:8888:80"

    opensearch:
        ports:
            - "127.0.0.1:9200:9200"

    opensearch-dashboards:
        ports:
            - "127.0.0.1:5601:5601"

    search-api:
        ports:
