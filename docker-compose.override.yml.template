services:
    airflow-apiserver:
        ports:
            - "127.0.0.1:8081:8080"

    transform:
        ports:
            - "127.0.0.1:8080:80"
        # Uncomment for dev (hot reload):
        # command: [ "fastapi", "dev", "--host", "0.0.0.0", "app/routes.py", "--port", "80" ]

    postgres:
        ports:
            - "127.0.0.1:5432:5432"

    pgadmin:
        ports:
            - "127.0.0.1:8888:80"

    opensearch:
        ports:
            - "127.0.0.1:9200:9200"

    opensearch-dashboards:
        ports:
            - "127.0.0.1:5601:5601"

    search-api:
        ports:
            - "127.0.0.1:8000:8000"

    frontend:
        ports:
            - "127.0.0.1:3000:3000"
