EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 # https://qdrant.github.io/fastembed/examples/Supported_Models/
EMBEDDING_DIMS=384 # depends on EMBEDDING_MODEL
INDEX_NAME=test_datacite
EMBED_API_URL=https://llm.ai.egi.eu/v1
TRANSFORM_BATCH_SIZE=250 # harvest events per mapped transformation task
ENVIRONMENT= # production/staging/dev/local

TOOL_DB=tooldb
TOOL_DB_USER=${POSTGRES_ADMIN}
TOOL_DB_PASSWORD=${POSTGRES_PASSWORD}

# Switching between production, development and demo for EGI checkin endpoints
EGI_CHECKIN_ENV=development

# Airflow, which runs all the python jobs (see dags/)
AIRFLOW_ADMIN=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_DB=airflowdb
# Credentials of the rabbitmq broker the scheduler queues tasks on
RABBITMQ_ADMIN=airflow
RABBITMQ_PW=airflow
# Task slots per airflow-worker container, and the cluster wide ceiling across all of them.
# Each transformation task loads its own embedding model, so these are bounded by RAM.
AIRFLOW_WORKER_CONCURRENCY=2
AIRFLOW_PARALLELISM=2
# On linux, set to the output of `id -u` so the mounted dags/logs stay writable by your user
AIRFLOW_UID=50000
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# openssl rand -hex 32
AIRFLOW_JWT_SECRET=


# Docker address of transformer, used by Crawler
WAREHOUSE_API_URL=http://transform:80
